            },
            {
                name: '제주',
                cityCode: 39,
                lat: 33.38281138792436,
                lng: 126.54332148138465,
                representativeLat: 33.35096043,
                representativeLng: 126.3866775,
            },
        ];

        window.onload = async () => {
            const url = await (createSkinImage('@Html.Raw(ViewBag.uri)', @ViewBag.type, @ViewBag.code, decodeURIComponent('@Html.Raw(ViewBag.golfClubName)'), '@ViewBag.playDate', '@ViewBag.score'));
        document.getElementById("img").src = url;
    }

    function codeToAddressName(code) {
        for (const cityInfo of cityInfoList) {
            if (cityInfo.cityCode === code)
                return {
                    name: cityInfo.name,
                    lat: cityInfo.lat,
                    lng: cityInfo.lng,
                };
        }

        return null;
        };

    async function createSkinImage(image, skinType, code = 0, golfClubName, playDate, score) {
        if (score) {
            score = `Score ${score}`;
        } else {
            score = `Score 0`;
        }

        return new Promise((resolve, reject) => {
            const cityInfo = cityInfoList.find(e => e.cityCode === code);
            const { lat, lng } = cityInfo ? cityInfo : { lat: 0, lng: 0 };
            const t = 38.61509977158916;
            const b = 33.19447556823512;
            const l = 126.11168024257817;
            const r = 129.58470538004804;

            const canvas = document.createElement('canvas');
            const context = canvas.getContext('2d');
            const imgMain = new Image();
            const svgLogo = new Image();
            const svgMap = new Image();
            const svgPin = new Image();

            imgMain.src = "/" + image;
            imgMain.crossOrigin = 'Anonymous';
            svgLogo.src = '/images2/logo_golmap2.svg';
            svgLogo.crossOrigin = 'Anonymous';
            svgMap.src = '/images2/map.svg';
            svgMap.crossOrigin = 'Anonymous';
            svgPin.src = '/images2/pin.svg';
            svgPin.crossOrigin = 'Anonymous';

            let imgCnt = 4;

            const loadImages = async () => {
                canvas.width = imgMain.width;
                canvas.height = imgMain.height;
                context.drawImage(imgMain, 0, 0);
                


      // 5300w / 4000h
      const ratio = imgMain.height / 4000;
      let backgroundHeight = Math.floor(600 * ratio);
      let logoWidth = Math.floor(424 * ratio);
      let logoHeight = Math.floor(400 * ratio);
      let mapWidth = Math.floor(1060 * ratio);
      let mapHeight = Math.floor(1440 * ratio);
      let widthPadding = Math.floor(80 * ratio);
      let heightPadding = Math.floor(80 * ratio);
      let pinWidth = Math.floor(128 * ratio);
      let pinHeight = Math.floor(160 * ratio);
      const bigFontSize = Math.floor(200 * ratio);
      const smallFontsize = Math.floor(160 * ratio);
      const textTopY = imgMain.height - backgroundHeight + Math.floor(100 * ratio);
      const textBottomY = imgMain.height - backgroundHeight + Math.floor(340 * ratio);
    //   const textTopY = imgMain.height - backgroundHeight + Math.floor(70 * ratio);
    //   const textBottomY = imgMain.height - backgroundHeight + Math.floor(310 * ratio);

      const pinX = mapWidth * (1 - (r - lng) / (r - l)) - (pinWidth / 2);
      const pinY = mapHeight * ((t - lat) / (t - b)) - pinHeight;
      
      const measureText = (text, fontSize=bigFontSize) => {
        const wp = widthPadding;
        context.font = `italic ${fontSize}px 'Malgun Gothic', '맑은 고딕', sans-serif`;
        const {width} = context.measureText(text);

        return {
          width: width + wp
        };
      };

      const drawText = (text, x, y, fontSize=bigFontSize) => {
        context.font = `italic ${fontSize}px 'Malgun Gothic', '맑은 고딕', sans-serif`;
        let { width } = context.measureText(text);
        let height = fontSize;
        const radius = Math.floor(fontSize / 4);
        const wp = widthPadding;
        const hp = Math.floor(heightPadding / 4);
        width = width + wp;
        height = height + hp;

        // context.beginPath();
        // context.moveTo(x  + radius, y);
        // context.arcTo(x + width, y, x + width, y + height, radius);
        // context.arcTo(x + width, y + height, x, y + height, radius);
        // context.arcTo(x, y + height, x, y, radius);
        // context.arcTo(x, y, x + width, y, radius);
        // context.closePath();
        // context.fillStyle = `rgba(255, 255, 255, 0.4)`;
        // context.fill();

        context.fillStyle = '#fff';
        context.fillText(text, x + wp/2, y + height - hp * 2);

        return {
          width,
          height
        };
      };

      context.globalAlpha = 0.6;
      context.fillStyle = '#002b4f';
      context.fillRect(
        0,
        imgMain.height - backgroundHeight,
        imgMain.width,
        backgroundHeight,
      );
      context.globalAlpha = 1;

      if (skinType === 1) {
        context.drawImage(
            svgLogo, 
            0, 
            0, 
            svgLogo.width,
            svgLogo.height,
            imgMain.width - logoWidth - widthPadding,
            heightPadding,
            logoWidth,
            logoHeight
        );
        
        context.globalAlpha = 0.5;
        context.drawImage(
          svgMap,
          0,
          0,
          svgMap.width,
          svgMap.height,
          imgMain.width - mapWidth - widthPadding,
          imgMain.height - mapHeight - heightPadding,
          mapWidth,
          mapHeight
        );
        context.globalAlpha = 1;

        if (golfClubName) {
        //   drawText(golfClubName, widthPadding * 2, imgMain.height - (backgroundHeight / 2) - (bigFontSize/2) - (35 * ratio)); 
          drawText(golfClubName, widthPadding * 2, imgMain.height - (backgroundHeight / 2) - (bigFontSize/2)); 
        }
        if (code !== 0) {
          context.drawImage(
            svgPin,
            0,
            0,
            svgPin.width,
            svgPin.height,
            imgMain.width - mapWidth - widthPadding + pinX,
            imgMain.height - mapHeight - heightPadding + pinY,
            pinWidth,
            pinHeight
          );
        }
      } else if (skinType === 2) {
        context.drawImage(
            svgLogo, 
            0, 
            0, 
            svgLogo.width,
            svgLogo.height,
            imgMain.width - logoWidth - widthPadding,
            heightPadding,
            logoWidth,
            logoHeight
        );
        
        context.globalAlpha = 0.5;
        context.drawImage(
          svgMap,
          0,
          0,
          svgMap.width,
          svgMap.height,
          imgMain.width - mapWidth - widthPadding,
          imgMain.height - mapHeight - heightPadding,
          mapWidth,
          mapHeight
        );
        context.globalAlpha = 1;

        if (playDate) {
            drawText(playDate, widthPadding * 2, textBottomY, smallFontsize);   
        }
        if (golfClubName) {
          drawText(golfClubName, widthPadding * 2, textTopY); 
        }
        if (code !== 0) {
          context.drawImage(
            svgPin,
            0,
            0,
            svgPin.width,
            svgPin.height,
            imgMain.width - mapWidth - widthPadding + pinX,
            imgMain.height - mapHeight - heightPadding + pinY,
            pinWidth,
            pinHeight
          );
        }
      } else if (skinType === 3) {
        context.drawImage(
            svgLogo, 
            0, 
            0, 
            svgLogo.width,
            svgLogo.height,
            imgMain.width - logoWidth - widthPadding,
            heightPadding,
            logoWidth,
            logoHeight
        );
        
        context.globalAlpha = 0.5;
        context.drawImage(
          svgMap,
          0,
          0,
          svgMap.width,
          svgMap.height,
          imgMain.width - mapWidth - widthPadding,
          imgMain.height - mapHeight - heightPadding,
          mapWidth,
          mapHeight
        );
        context.globalAlpha = 1;

        if (playDate && score) {
          const { width } = drawText(playDate, widthPadding * 2, textBottomY, smallFontsize);   
          drawText(score, widthPadding * 2 + width, textBottomY, smallFontsize);   
        }
        if (golfClubName) {
          drawText(golfClubName, widthPadding * 2, textTopY); 
        }
        if (code !== 0) {
          context.drawImage(
            svgPin,
            0,
            0,
            svgPin.width,
            svgPin.height,
            imgMain.width - mapWidth - widthPadding + pinX,
            imgMain.height - mapHeight - heightPadding + pinY,
            pinWidth,
            pinHeight
          );
        }
      } else if (skinType === 4) {
        context.drawImage(
            svgLogo, 
            0, 
            0, 
            svgLogo.width,
            svgLogo.height,
            imgMain.width - logoWidth - widthPadding,
            heightPadding,
            logoWidth,
            logoHeight
        );

        if (playDate && score) {
            const { width } = drawText(playDate, widthPadding * 2, textBottomY, smallFontsize);   
            drawText(score, widthPadding * 2 + width, textBottomY, smallFontsize);   
          }
          if (golfClubName) {
            drawText(golfClubName, widthPadding * 2, textTopY); 
          }
      }

                canvas.toBlob((blob) => {
                    getOrientation(blob);
                    saveAs(blob, "golmap.png");
                });

                const url = canvas.toDataURL('image/jpeg');
                
                resolve(url);
            };

            const decreaseCntAndRun = () => {
                imgCnt--;
                if (imgCnt === 0) loadImages();
            };

            imgMain.onload = () => {
                decreaseCntAndRun();
            };

            svgLogo.onload = () => {
                decreaseCntAndRun();
            };

            svgMap.onload = () => {
                decreaseCntAndRun();
            };

            svgPin.onload = () => {
                decreaseCntAndRun();
            }
        });
    };
    </script>

