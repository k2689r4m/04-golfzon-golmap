                representativeLat: 34.95963431,
                representativeLng: 126.8734753,
            },
            {
                name: '경북',
                cityCode: 37,
                lat: 36.50310367444907,
                lng: 128.643945838955188,
                representativeLat: 36.16178586,
                representativeLng: 128.4496731,
            },
            {
                name: '경남',
                cityCode: 38,
                lat: 35.45451293686896,
                lng: 128.1570836146571,
                representativeLat: 35.39521319,
